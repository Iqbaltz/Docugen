{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Authentication": {
    "Schemes": {
      "Bearer": {
        "Authority": "",
        "ValidAudiences": []
      }
    }
  },
  "Docugen": {
    "ReportsPath": "reports",
    "DefaultCulture": "en-US",
    "DataSources": {
      "SalesDb": {
        "Provider": "SqlServer",
        "ConnectionString": "Server=YOUR-SQL-SERVER;Database=Sales;Authentication=Active Directory Default;Encrypt=True;ApplicationIntent=ReadOnly"
      }
    },
    "Limits": {
      "MaxRows": 500000,
      "MaxPdfRows": 5000,
      "DefaultCommandTimeoutSeconds": 60,
      "MaxConcurrentRenders": 8,
      "MaxQueuedRenders": 50
    },
    "Csv": {
      "Delimiter": ",",
      "IncludeBom": true,
      "EscapeFormulas": true,
      "Culture": ""
    },
    "Pdf": {
      "BrowserExecutablePath": null,
      "MaxConcurrentRenders": 4,
      "RenderTimeoutSeconds": 120
    }
  }
}
