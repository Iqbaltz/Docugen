{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "EndpointDefaults": {
      "Protocols": "Http2"
    }
  },
  "Authentication": {
    "Schemes": {
      "Bearer": {
        "Authority": "",
        "ValidAudiences": []
      }
    }
  },
  "Docugen": {
    "Store": {
      "Provider": "SqlServer",
      "ConnectionString": "Server=(localdb)\\MSSQLLocalDB;Database=Docugen;Integrated Security=True;TrustServerCertificate=True"
    },
    "DefaultCulture": "en-US",
    "DataSources": {
      "SalesDb": {
        "Provider": "SqlServer",
        "ConnectionString": "Server=(localdb)\\MSSQLLocalDB;Database=DocugenSales;Integrated Security=True;TrustServerCertificate=True"
      }
    },
    "Catalog": {
      "RefreshInterval": "00:00:30"
    },
    "Limits": {
      "MaxRows": 500000,
      "MaxPdfRows": 5000,
      "DefaultCommandTimeoutSeconds": 60,
      "MaxConcurrentExports": 8,
      "MaxQueuedExports": 50
    },
    "Csv": {
      "Delimiter": ",",
      "IncludeBom": true,
      "EscapeFormulas": true,
      "Culture": ""
    },
    "Pdf": {
      "BrowserExecutablePath": null,
      "MaxConcurrentRenders": 4,
      "RenderTimeoutSeconds": 120
    }
  }
}
