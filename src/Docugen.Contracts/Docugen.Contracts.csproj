<Project Sdk="Microsoft.NET.Sdk">

  <!-- The gRPC contract. Other .NET apps can reference this project (or its package) for a typed client;
       apps in other languages generate their client from Protos/docugen/v1/docugen.proto. -->

  <PropertyGroup>
    <RootNamespace>Docugen.Contracts</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Grpc.Core.Api" />
    <PackageReference Include="Grpc.Tools" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="Protos\docugen\v1\docugen.proto" ProtoRoot="Protos" GrpcServices="Both" />
  </ItemGroup>

</Project>
